WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
EOL = _{ ";" }
NEWLINE = _{ "\n" | "\r\n" }
COMMENT = _{
    "//" ~
    (!NEWLINE ~ ANY)*
}
KeywordBoundary = _{ !(ASCII_ALPHANUMERIC | "_") }

Program = {
    SOI ~
    Statement* ~
    EOI
}
// Keywords
Keyword = {
    KeywordFn |
    KeywordLet |
    KeywordReturn
}
KeywordFn = @{ "fn" ~ KeywordBoundary }
KeywordLet = @{ "let" ~ KeywordBoundary }
KeywordReturn = @{ "return" ~ KeywordBoundary }

// Execution
Block = {
    LBrace ~
    Statement* ~
    RBrace
}

FunctionDefinition = {
    KeywordFn ~ Identifier ~ LParen ~ RParen ~ Block
}

FunctionCall = {
    Identifier ~ LParen ~ RParen
}

// Operators
Equals = { "=" }

// Tokens
LBrace = { "{" }
RBrace = { "}" }
LParen = { "(" }
RParen = { ")" }

Identifier = @{
    (ASCII_ALPHA | "_") ~
    (ASCII_ALPHANUMERIC | "_")*
}

DataType = {
    "u32" | "s32"
}

Integer = @{ ASCII_DIGIT+ }

// Types of values

Value = {
    Identifier |
    Integer
}

Statement = {
    FunctionDefinition |
    Assignment ~ EOL |
    Return ~ EOL |
    Expression ~ EOL
}

Assignment = {
    KeywordLet? ~ Identifier ~ Equals ~ Expression
}

Return = {
    KeywordReturn ~ Expression
}

Expression = {
    FunctionCall |
    Value
}
