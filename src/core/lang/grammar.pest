WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
EOL = _{ ";" }
NEWLINE = _{ "\n" | "\r\n" }
COMMENT = _{
    "//" ~
    (!NEWLINE ~ ANY)*
}
KeywordBoundary = _{ !(ASCII_ALPHANUMERIC | "_") }

Program = {
    SOI ~
    Statement* ~
    EOI
}

// Keywords
Keyword = {
    KeywordFn |
    KeywordLet |
    KeywordReturn |
    KeywordStruct |
    KeywordImpl |
    KeywordIf |
    KeywordElse |
    KeywordTrue |
    KeywordFalse |
    KeywordWhile |
    KeywordBreak |
    KeywordSelf |
    KeywordPad |
    KeywordFor |
    KeywordIn |
    KeywordAs
}

KeywordFn = @{ "fn" ~ KeywordBoundary }
KeywordLet = @{ "let" ~ KeywordBoundary }
KeywordReturn = @{ "return" ~ KeywordBoundary }
KeywordStruct = @{ "struct" ~ KeywordBoundary }
KeywordImpl = @{ "impl" ~ KeywordBoundary }
KeywordIf = @{ "if" ~ KeywordBoundary }
KeywordElse = @{ "else" ~ KeywordBoundary }
KeywordTrue  = @{ "true" ~ KeywordBoundary }
KeywordFalse = @{ "false" ~ KeywordBoundary }
KeywordWhile = @{ "while" ~ KeywordBoundary }
KeywordLoop = @{ "loop" ~ KeywordBoundary }
KeywordBreak = @{ "break" ~ KeywordBoundary }
KeywordSelf = @{ "self" ~ KeywordBoundary }
KeywordPad = @{ "pad" ~ KeywordBoundary }
KeywordFor = @{ "for" ~ KeywordBoundary }
KeywordIn = @{ "in" ~ KeywordBoundary }
KeywordAs = @{ "as" ~ KeywordBoundary }

// Execution
Block = {
    LBrace ~
        Statement* ~
    RBrace
}

FunctionDefinition = {
    Attribute* ~
    KeywordFn ~ Identifier ~ LParen ~ ParameterList? ~ RParen ~ Block
}

FunctionCall = {
    QualifiedIdentifier ~ GenericArguments? ~ LParen ~ ArgumentList? ~ RParen
}

GenericArguments = {
    "<" ~ DataType ~ (Comma ~ DataType)* ~ ">"
}

ParameterList = { // only allowing our defined data types for now
    Parameter ~ (Comma ~ Parameter)*
}

Parameter = {
    Identifier ~ Colon ~ DataType
}

ArgumentList = {
    Expression ~ (Comma ~ Expression)*
}

// Operators and tokens
Plus            =  { "+" }
Subtract        =  { "-" }
Star            =  _{ "*" }
Multiply        =  { "*" } // <- this is explicitly for multiplication and nothing else
Slash           =  { "/" }
Dot             = _{ "." }
Comma           = _{ "," }
Equals          = _{ "=" }
Colon           = _{ ":" }
Semicolon       = _{ ";" }
ScopeResolution = _{ "::" }
LBrace          = _{ "{" }
RBrace          = _{ "}" }
LParen          = _{ "(" }
RParen          = _{ ")" }
LBracket        = _{ "[" }
RBracket        = _{ "]" }
Pound           = _{ "#" }
Hashtag         = _{ Pound }
Ampersand       = _{ "&" ~ !"&" }
GreaterThan     = { ">" }
LessThan        = { "<" }
EqualTo         = { "==" }
NotEqualTo      = { "!=" }
GreaterThanOrEqualTo = { ">=" }
LessThanOrEqualTo = { "<=" }
DotDot = { ".." }
Percent     = { "%" }
Pipe        = { "|" }
Caret       = { "^" }
Amp         = { "&" ~ !"&" }   // bitwise AND
OrOr        = { "||" }
AndAnd      = { "&&" }
ShiftLeft   = { "<<" }
ShiftRight  = { ">>" }
ExclamationMark = _{ "!" }
Tilde = _{ "~" }
Minus = _{ "-" }

ComparisonOp = _{
    GreaterThanOrEqualTo |
    LessThanOrEqualTo |
    EqualTo |
    NotEqualTo |
    GreaterThan |
    LessThan
}

Identifier = @{
    (ASCII_ALPHA | "_") ~
    (ASCII_ALPHANUMERIC | "_")*
}

QualifiedIdentifier = {
    Identifier ~ (ScopeResolution ~ Identifier)*
}

BuiltinDataType = {
    "s8" | "u8" | "s16" | "u16" | "s32" | "u32" | "string" | "bool" | "usize"
}

DataType = {
    ArrayType |
    SingleDataType
}

SingleDataType = {
    ReferenceType |
    BuiltinDataType |
    Identifier
}

ArrayType = { // if the ; integer is missing then it's a dependent type
    LBracket ~ DataType ~ (Semicolon ~ Integer)? ~ RBracket
}

ReferenceType = {
    Ampersand ~ DataType
}

TypeAnnotation = {
    Colon ~ DataType
}

Integer = @{
    HexadecimalInteger |
    DecimalInteger
}

Bool = {
    KeywordTrue | KeywordFalse
}

HexadecimalInteger = @{ ("0x" | "0X") ~ ASCII_HEX_DIGIT+ }
DecimalInteger = @{ ASCII_DIGIT+ }

String = @{
    "\"" ~ StringCharacter* ~ "\""
}

StringCharacter = {
    EscapeSequence |
    !("\"" | "\\") ~ ANY
}

EscapeSequence = {
    "\\" ~ (
        "\"" |
        "\\" |
        "n" |
        "r" |
        "t"
    )
}

Value = {
    Bool |
    Integer |
    String |
    Identifier
}

Statement = {
    ForStatement |
    LoopStatement |
    IfStatement |
    WhileStatement |
    StructImplBlock |
    FunctionDefinition |
    StructDefinition |
    Assignment ~ EOL |
    Return ~ EOL |
    BreakStatement ~ EOL |
    Expression ~ EOL
}

BreakStatement = {
    KeywordBreak
}

LoopStatement = {
    KeywordLoop ~ Block
}

IfStatement = {
    KeywordIf ~ Comparison ~ Block ~ ElseIfStatement* ~ ElseStatement?
}

ElseIfStatement = {
    KeywordElse ~ KeywordIf ~ Comparison ~ Block
}

ElseStatement = {
    KeywordElse ~ Block
}

WhileStatement = {
    KeywordWhile ~ Comparison ~ Block
}

ForStatement = {
    KeywordFor ~ Identifier ~ KeywordIn ~ Expression ~ Block
}

DeclarativeAssignment = {
    KeywordLet ~ Identifier ~ TypeAnnotation? ~ Equals ~ Expression
}

Reassignment = {
    AssignmentTarget ~ Equals ~ Expression
}

AssignmentTarget = {
    AssignmentDereference |
    AssignmentPostfix
}

AssignmentDereference = {
    Star ~ AssignmentTarget
}

AssignmentPostfix = {
    Identifier ~ AssignmentPostfixOperation*
}

AssignmentPostfixOperation = _{
    FieldAccess |
    ArrayAccess
}

Assignment = {
    DeclarativeAssignment |
    Reassignment
}

Return = {
    KeywordReturn ~ Expression
}

Expression = {
    Range
}

Range = {
    LogicalOr ~ (DotDot ~ LogicalOr)?
}

LogicalOr = {
    LogicalAnd ~ (LogicalOrOp ~ LogicalAnd)*
}

LogicalOrOp = _{
    OrOr
}

LogicalAnd = {
    BitwiseOr ~ (LogicalAndOp ~ BitwiseOr)*
}

LogicalAndOp = _{
    AndAnd
}

BitwiseOr = {
    BitwiseXor ~ (BitwiseOrOp ~ BitwiseXor)*
}

BitwiseOrOp = _{
    Pipe
}

BitwiseXor = {
    BitwiseAnd ~ (BitwiseXorOp ~ BitwiseAnd)*
}

BitwiseXorOp = _{
    Caret
}

BitwiseAnd = {
    Comparison ~ (BitwiseAndOp ~ Comparison)*
}

BitwiseAndOp = _{
    Amp
}

Comparison = {
    Shift ~ (ComparisonOp ~ Shift)*
}

Shift = {
    Addition ~ (ShiftOp ~ Addition)*
}

ShiftOp = _{
    ShiftLeft |
    ShiftRight
}

Addition = {
    Multiplication ~ (AddOp ~ Multiplication)*
}

Multiplication = {
    TypeCast ~ (MulOp ~ TypeCast)*
}

MulOp = _{
    Multiply | Slash | Percent
}

AddOp = _{
    Plus | Subtract
}

TypeCast = {
    Unary ~ (KeywordAs ~ DataType)*
}

Unary = {
    Reference |
    Dereference |
    Negation |
    LogicalNot |
    BitwiseNot |
    Postfix
}

Negation = {
    Minus ~ Unary
}

LogicalNot = {
    ExclamationMark ~ Unary
}

BitwiseNot = {
    Tilde ~ Unary
}

Reference = {
    Ampersand ~ Unary
}

Dereference = {
    Star ~ Unary
}

Postfix = {
    Atom ~ (PostfixOperation)*
}

PostfixOperation = _{
    MethodCall |
    FieldAccess |
    ArrayAccess
}

ArrayAccess = {
    LBracket ~ Expression ~ RBracket
}

// distinct from FunctionCall; a method here is a function attached to a struct
MethodCall = {
    Dot ~ Identifier ~ LParen ~ ArgumentList? ~ RParen
}

FieldAccess = {
    Dot ~ Identifier
}

Atom = {
    StructInitialization |
    ArrayInitialization |
    FunctionCall |
    Value |
    (LParen ~ Expression ~ RParen)
}

ArrayInitialization = {
    LBrace ~ ArrayInitializers? ~ (Comma? ~ DotDot)? ~ RBrace
}

ArrayInitializers = {
    Expression ~ (Comma ~ Expression)*
}

StructInitialization = {
    Identifier ~ LBrace ~
        StructFieldInitializers? ~
        (Comma? ~ DotDot)? ~
    RBrace
}

StructFieldInitializers = {
    StructFieldInitializer ~ (Comma ~ StructFieldInitializer)*
}

StructFieldInitializer = {
    Identifier ~ Colon ~ Expression
}

StructDefinition = {
    Attribute* ~
    KeywordStruct ~ Identifier ~ LBrace ~
        StructMembers? ~
    RBrace
}

StructMembers = {
    StructMember ~ (Comma ~ StructMember)*
}

StructMember = {
    StructFieldDefinition |
    PadDirective
}

PadDirective = {
    KeywordPad ~ LParen ~ Integer ~ RParen
}

StructFieldDefinition = {
    Attribute* ~
    Identifier ~ Colon ~ DataType
}

StructImplBlock = {
    KeywordImpl ~ Identifier ~ LBrace ~
        StructImplDefinitions? ~
    RBrace
}

StructImplDefinitions = {
    (FunctionDefinition | MethodDefinition)*
}

MethodDefinition = {
    Attribute* ~
    KeywordFn ~ Identifier ~ LParen ~ Ampersand ~ KeywordSelf ~ ParameterList? ~ RParen ~ Block
}

Attribute = {
    Hashtag ~
    LBracket ~
    Identifier ~
    AttributeArguments? ~
    RBracket
}

AttributeArguments = {
    LParen ~
    ArgumentList? ~
    RParen
}
